{
    "version": "2.0.0",
    "tasks": [

        // ===========================================
        //                BUILD DEBUG
        // ===========================================
        {
            "label": "Build Debug",
            "type": "shell",
            "command": "echo Unsupported OS",
            "windows": {
                "command": "if exist build_win rmdir /S /Q build_win && mkdir build_win && cd build_win && cmake -G \"NMake Makefiles\" -DCMAKE_BUILD_TYPE=Debug .. && nmake"
            },
            "linux": {
                "command": "rm -rf build_linux && mkdir build_linux && cd build_linux && cmake -DCMAKE_BUILD_TYPE=Debug .. && make -j$(nproc)"
            },
            "options": { "cwd": "${workspaceFolder}" },
            "group": "build"
        },

        // ===========================================
        //                BUILD RELEASE
        // ===========================================
        {
            "label": "Build Release",
            "type": "shell",
            "command": "echo Unsupported OS",
            "windows": {
                "command": "if exist build_win rmdir /S /Q build_win && mkdir build_win && cd build_win && cmake -G \"NMake Makefiles\" -DCMAKE_BUILD_TYPE=Release .. && nmake"
            },
            "linux": {
                "command": "rm -rf build_linux && mkdir build_linux && cd build_linux && cmake -DCMAKE_BUILD_TYPE=Release .. && make -j$(nproc)"
            },
            "options": { "cwd": "${workspaceFolder}" },
            "group": "build"
        },

        // ===========================================
        //                    RUN
        // ===========================================
        {
            "label": "Run Neutralino",
            "type": "shell",
            "command": "echo Unsupported OS",
            "windows": {
                "command": ".\\bin\\neutralino-win_x64.exe"
            },
            "linux": {
                "command": "./bin/neutralino-linux_x64"
            },
            "options": { "cwd": "${workspaceFolder}" },
            "group": "test"
        },

        // ===========================================
        //             BUILD + RUN DEBUG
        // ===========================================
        {
            "label": "Build & Run Debug",
            "type": "shell",
            "dependsOn": "Build Debug",
            "command": "echo Unsupported OS",
            "windows": {
                "command": ".\\bin\\neutralino-win_x64.exe"
            },
            "linux": {
                "command": "./bin/neutralino-linux_x64"
            },
            "options": { "cwd": "${workspaceFolder}" },
            "group": "build"
        }
    ]
}
