{
    "version": "2.0.0",
    "tasks": [

        // ===========================================
        //                BUILD DEBUG
        // ===========================================
        {
            "label": "Build Debug",
            "type": "shell",
            "command": "echo Unsupported OS",
            "windows": {
                "command": ".vscode\\build_win.bat"
            },
            "linux": {
                "command": "chmod +x .vscode/build_linux.sh && .vscode/build_linux.sh"
            },
            "options": { "cwd": "${workspaceFolder}" },
            "group": "build"
        },
        // ===========================================
        //                BUILD RELEASE
        // ===========================================
        {
            "label": "Build Release",
            "type": "shell",
            "command": "echo Unsupported OS",
            "windows": {
                "command": ".vscode\\build_win.bat"
            },
            "linux": {
                "command": "chmod +x .vscode/build_linux.sh && .vscode/build_linux.sh Release"
            },
            "options": { "cwd": "${workspaceFolder}" },
            "group": "build"
        },

        // ===========================================
        //                    RUN
        // ===========================================
        {
            "label": "Run Neutralino",
            "type": "shell",
            "command": "echo Unsupported OS",
            "windows": {
                "command": ".\\bin\\neutralino-win_x64.exe"
            },
            "linux": {
                "command": "./bin/neutralino-linux_x64"
            },
            "options": { "cwd": "${workspaceFolder}" },
            "group": "test"
        },

        // ===========================================
        //             BUILD + RUN DEBUG
        // ===========================================
        {
            "label": "Build & Run Debug",
            "type": "shell",
            "dependsOn": "Build Debug",
            "command": "echo Unsupported OS",
            "windows": {
                "command": ".\\bin\\neutralino-win_x64.exe"
            },
            "linux": {
                "command": "./bin/neutralino-linux_x64"
            },
            "options": { "cwd": "${workspaceFolder}" },
            "group": "build"
        }
    ]
}
